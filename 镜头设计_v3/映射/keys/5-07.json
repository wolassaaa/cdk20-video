 "sentences": [
  {
   "sid": "5-07.s1",
   "text": "Not at all.",
   "w_first": "5-07.w001",
   "w_last": "5-07.w003",
   "f0": 9,
   "f1": 44
  },
  {
   "sid": "5-07.s2",
   "text": "This is where the loop kicks in again, now with real lab data inside.",
   "w_first": "5-07.w004",
   "w_last": "5-07.w017",
   "f0": 106,
   "f1": 459
  },
  {
   "sid": "5-07.s3",
   "text": "The results went back in, with a predicted pose of how 001 sat in the pocket.",
   "w_first": "5-07.w018",
   "w_last": "5-07.w033",
   "f0": 485,
   "f1": 866
  },
  {
   "sid": "5-07.s4",
   "text": "Sixteen new designs.",
   "w_first": "5-07.w034",
   "w_last": "5-07.w036",
   "f0": 904,
   "f1": 974
  },
  {
   "sid": "5-07.s5",
   "text": "Six made and tested.",
   "w_first": "5-07.w037",
   "w_last": "5-07.w040",
   "f0": 990,
   "f1": 1065
  },
  {
   "sid": "5-07.s6",
   "text": "All within 30 days of that first hit.",
   "w_first": "5-07.w041",
   "w_last": "5-07.w048",
   "f0": 1099,
   "f1": 1263
  }
 ],
