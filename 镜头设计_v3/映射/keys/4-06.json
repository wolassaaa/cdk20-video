 "sentences": [
  {
   "sid": "4-06.s1",
   "text": "And this next part honestly blew my mind.",
   "w_first": "4-06.w001",
   "w_last": "4-06.w008",
   "f0": 9,
   "f1": 160
  },
  {
   "sid": "4-06.s2",
   "text": "Think about how chemists have always found a key.",
   "w_first": "4-06.w009",
   "w_last": "4-06.w017",
   "f0": 201,
   "f1": 366
  },
  {
   "sid": "4-06.s3",
   "text": "Imagine a molecule.",
   "w_first": "4-06.w018",
   "w_last": "4-06.w020",
   "f0": 415,
   "f1": 482
  },
  {
   "sid": "4-06.s4",
   "text": "Make it.",
   "w_first": "4-06.w021",
   "w_last": "4-06.w022",
   "f0": 512,
   "f1": 539
  },
  {
   "sid": "4-06.s5",
   "text": "Test it.",
   "w_first": "4-06.w023",
   "w_last": "4-06.w024",
   "f0": 563,
   "f1": 595
  },
  {
   "sid": "4-06.s6",
   "text": "It fails.",
   "w_first": "4-06.w025",
   "w_last": "4-06.w026",
   "f0": 623,
   "f1": 659
  },
  {
   "sid": "4-06.s7",
   "text": "Tweak it.",
   "w_first": "4-06.w027",
   "w_last": "4-06.w028",
   "f0": 701,
   "f1": 727
  },
  {
   "sid": "4-06.s8",
   "text": "Try again.",
   "w_first": "4-06.w029",
   "w_last": "4-06.w030",
   "f0": 749,
   "f1": 791
  },
  {
   "sid": "4-06.s9",
   "text": "And every single round in a real lab costs time and money.",
   "w_first": "4-06.w031",
   "w_last": "4-06.w042",
   "f0": 834,
   "f1": 1047
  }
 ],
