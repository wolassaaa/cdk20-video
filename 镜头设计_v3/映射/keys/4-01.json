 "sentences": [
  {
   "sid": "4-01.s1",
   "text": "So the team did something that once sounded like science fiction.",
   "w_first": "4-01.w001",
   "w_last": "4-01.w011",
   "f0": 4,
   "f1": 271
  },
  {
   "sid": "4-01.s2",
   "text": "They asked an AI to guess the shape.",
   "w_first": "4-01.w012",
   "w_last": "4-01.w019",
   "f0": 312,
   "f1": 458
  },
  {
   "sid": "4-01.s3",
   "text": "Imagine a protein as a chain of building blocks that folds into a 3D shape.",
   "w_first": "4-01.w020",
   "w_last": "4-01.w034",
   "f0": 510,
   "f1": 811
  },
  {
   "sid": "4-01.s4",
   "text": "The order of the blocks is the sequence.",
   "w_first": "4-01.w035",
   "w_last": "4-01.w042",
   "f0": 860,
   "f1": 986
  },
  {
   "sid": "4-01.s5",
   "text": "AlphaFold learned from known structures how sequences fold.",
   "w_first": "4-01.w043",
   "w_last": "4-01.w050",
   "f0": 1041,
   "f1": 1285
  },
  {
   "sid": "4-01.s6",
   "text": "Give it one, and it predicts the shape, plus how sure it is about each part.",
   "w_first": "4-01.w051",
   "w_last": "4-01.w066",
   "f0": 1316,
   "f1": 1681
  }
 ],
