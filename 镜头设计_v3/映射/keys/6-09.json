   "w_last": "6-09.w020",
   "f0": 35,
   "f1": 327
  },
  {
   "sid": "6-09.s3",
   "text": "Computing costs electricity too.",
   "w_first": "6-09.w021",
   "w_last": "6-09.w024",
   "f0": 369,
   "f1": 476
  },
  {
   "sid": "6-09.s4",
   "text": "And the real prize?",
