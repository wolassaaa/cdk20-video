 "sentences": [
  {
   "sid": "6-09.s1",
   "text": "Now imagine this keeps working further down the road.",
   "w_first": "6-09.w006",
   "w_last": "6-09.w009",
   "f0": 9,
   "f1": 35
  },
  {
   "sid": "6-09.s2",
   "text": "Fewer failed molecules, lower costs, fewer animal tests, less chemical waste.",
   "w_first": "6-09.w010",
   "w_last": "6-09.w020",
   "f0": 35,
   "f1": 327
  },
  {
   "sid": "6-09.s3",
   "text": "Computing costs electricity too.",
   "w_first": "6-09.w021",
   "w_last": "6-09.w024",
   "f0": 369,
   "f1": 476
  },
  {
   "sid": "6-09.s4",
   "text": "And the real prize?",
   "w_first": "6-09.w025",
   "w_last": "6-09.w028",
   "f0": 541,
   "f1": 595
  },
  {
   "sid": "6-09.s5",
   "text": "New treatments for patients.",
   "w_first": "6-09.w029",
   "w_last": "6-09.w032",
   "f0": 647,
   "f1": 721
  }
 ],
