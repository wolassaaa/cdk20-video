 "sentences": [
  {
   "sid": "4-07.s1",
   "text": "Generative AI takes that loop and moves it inside a computer.",
   "w_first": "4-07.w001",
   "w_last": "4-07.w011",
   "f0": 9,
   "f1": 237
  },
  {
   "sid": "4-07.s2",
   "text": "The platform here, Chemistry42, runs dozens of AI models side by side, built on known chemistry.",
   "w_first": "4-07.w012",
   "w_last": "4-07.w027",
   "f0": 280,
   "f1": 759
  },
  {
   "sid": "4-07.s3",
   "text": "They invent new molecules for this exact keyhole, score them, learn from the scores, and go again.",
   "w_first": "4-07.w028",
   "w_last": "4-07.w044",
   "f0": 811,
   "f1": 1199
  },
  {
   "sid": "4-07.s4",
   "text": "Its makers say it turns out new structures within hours.",
   "w_first": "4-07.w045",
   "w_last": "4-07.w054",
   "f0": 1245,
   "f1": 1447
  }
 ],
