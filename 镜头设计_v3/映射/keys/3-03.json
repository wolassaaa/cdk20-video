 "sentences": [
  {
   "sid": "3-03.s1",
   "text": "Scientists call the lock the target, and the key a candidate molecule.",
   "w_first": "3-03.w001",
   "w_last": "3-03.w012",
   "f0": 9,
   "f1": 301
  },
  {
   "sid": "3-03.s2",
   "text": "A good key fits its own lock tightly, and opens no one else's.",
   "w_first": "3-03.w013",
   "w_last": "3-03.w025",
   "f0": 330,
   "f1": 592
  },
  {
   "sid": "3-03.s3",
   "text": "That's called selectivity.",
   "w_first": "3-03.w026",
   "w_last": "3-03.w028",
   "f0": 634,
   "f1": 718
  }
 ],
