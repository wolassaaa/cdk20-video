 "sentences": [
  {
   "sid": "3-05.s1",
   "text": "Why this lock?",
   "w_first": "3-05.w001",
   "w_last": "3-05.w003",
   "f0": 9,
   "f1": 52
  },
  {
   "sid": "3-05.s2",
   "text": "Remember the Hong Kong team.",
   "w_first": "3-05.w004",
   "w_last": "3-05.w008",
   "f0": 69,
   "f1": 142
  },
  {
   "sid": "3-05.s3",
   "text": "In 36 of 52 liver tumours, CDK20 was higher than in nearby non-tumour tissue.",
   "w_first": "3-05.w009",
   "w_last": "3-05.w022",
   "f0": 166,
   "f1": 550
  },
  {
   "sid": "3-05.s4",
   "text": "High levels went with later-stage tumours and shorter survival.",
   "w_first": "3-05.w023",
   "w_last": "3-05.w031",
   "f0": 580,
   "f1": 809
  },
  {
   "sid": "3-05.s5",
   "text": "And turning CDK20 down in liver cancer cells slowed their growth.",
   "w_first": "3-05.w032",
   "w_last": "3-05.w042",
   "f0": 832,
   "f1": 1112
  }
 ],
