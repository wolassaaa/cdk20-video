 "sentences": [
  {
   "sid": "2-07.s1",
   "text": "For every source, we asked: what kind is it, how much did we read, and how strong is the evidence?",
   "w_first": "2-07.w001",
   "w_last": "2-07.w020",
   "f0": 9,
   "f1": 455
  },
  {
   "sid": "2-07.s2",
   "text": "Who did the work?",
   "w_first": "2-07.w021",
   "w_last": "2-07.w024",
   "f0": 488,
   "f1": 546
  },
  {
   "sid": "2-07.s3",
   "text": "Were there controls and repeats?",
   "w_first": "2-07.w025",
   "w_last": "2-07.w029",
   "f0": 578,
   "f1": 705
  },
  {
   "sid": "2-07.s4",
   "text": "One thing worth knowing: most authors of the main study work for Insilico Medicine, which built its AI tools.",
   "w_first": "2-07.w030",
   "w_last": "2-07.w048",
   "f0": 738,
   "f1": 1305
  },
  {
   "sid": "2-07.s5",
   "text": "They say so openly.",
   "w_first": "2-07.w049",
   "w_last": "2-07.w052",
   "f0": 1344,
   "f1": 1426
  },
  {
   "sid": "2-07.s6",
   "text": "Useful evidence, not an independent check.",
   "w_first": "2-07.w053",
   "w_last": "2-07.w058",
   "f0": 1453,
   "f1": 1648
  }
 ],
