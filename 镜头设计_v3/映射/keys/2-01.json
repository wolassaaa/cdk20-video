 "sentences": [
  {
   "sid": "2-01.s1",
   "text": "Hong Kong first.",
   "w_first": "2-01.w001",
   "w_last": "2-01.w003",
   "f0": 9,
   "f1": 64
  },
  {
   "sid": "2-01.s2",
   "text": "In 2011, a team at the Chinese University of Hong Kong studied liver tumours from patients at the Prince of Wales Hospital.",
   "w_first": "2-01.w004",
   "w_last": "2-01.w025",
   "f0": 89,
   "f1": 586
  },
  {
   "sid": "2-01.s3",
   "text": "One protein kept showing up raised: CCRK, also called CDK20.",
   "w_first": "2-01.w026",
   "w_last": "2-01.w035",
   "f0": 619,
   "f1": 929
  },
  {
   "sid": "2-01.s4",
   "text": "Fast forward to 2023: an AI drug-discovery study goes after the same protein, with co-authors at Insilico Medicine's Hong Kong office in Science Park.",
   "w_first": "2-01.w036",
   "w_last": "2-01.w059",
   "f0": 962,
   "f1": 1570
  }
 ],
