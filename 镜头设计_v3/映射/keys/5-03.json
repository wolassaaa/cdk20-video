 "sentences": [
  {
   "sid": "5-03.s1",
   "text": "001's Kd: 9.2 micromolar.",
   "w_first": "5-03.w001",
   "w_last": "5-03.w004",
   "f0": 9,
   "f1": 222
  },
  {
   "sid": "5-03.s2",
   "text": "The other six?",
   "w_first": "5-03.w005",
   "w_last": "5-03.w007",
   "f0": 248,
   "f1": 294
  },
  {
   "sid": "5-03.s3",
   "text": "All above 30.",
   "w_first": "5-03.w008",
   "w_last": "5-03.w010",
   "f0": 331,
   "f1": 398
  },
  {
   "sid": "5-03.s4",
   "text": "Much weaker.",
   "w_first": "5-03.w011",
   "w_last": "5-03.w012",
   "f0": 426,
   "f1": 467
  },
  {
   "sid": "5-03.s5",
   "text": "And here's the wild part.",
   "w_first": "5-03.w013",
   "w_last": "5-03.w017",
   "f0": 510,
   "f1": 590
  },
  {
   "sid": "5-03.s6",
   "text": "The clock read just 30 days, from picking the target to this first confirmed hit.",
   "w_first": "5-03.w018",
   "w_last": "5-03.w032",
   "f0": 642,
   "f1": 1001
  }
 ],
