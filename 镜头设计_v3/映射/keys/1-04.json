 "sentences": [
  {
   "sid": "1-04.s1",
   "text": "The standard first treatment for advanced liver cancer has already changed once, from Nexavar to a combo, atezolizumab plus bevacizumab.",
   "w_first": "1-04.w001",
   "w_last": "1-04.w020",
   "f0": 9,
   "f1": 646
  },
  {
   "sid": "1-04.s2",
   "text": "But here, only about three in ten patients are alive five years on.",
   "w_first": "1-04.w021",
   "w_last": "1-04.w033",
   "f0": 683,
   "f1": 973
  },
  {
   "sid": "1-04.s3",
   "text": "The study we follow calls it a huge unmet need.",
   "w_first": "1-04.w034",
   "w_last": "1-04.w043",
   "f0": 1011,
   "f1": 1252
  }
 ],
