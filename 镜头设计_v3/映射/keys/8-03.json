 "sentences": [
  {
   "sid": "8-03.s1",
   "text": "And our second?",
   "w_first": "8-03.w001",
   "w_last": "8-03.w003",
   "f0": 9,
   "f1": 67
  },
  {
   "sid": "8-03.s2",
   "text": "These methods helped the team assess candidates fast.",
   "w_first": "8-03.w004",
   "w_last": "8-03.w011",
   "f0": 92,
   "f1": 329
  },
  {
   "sid": "8-03.s3",
   "text": "Screening by the millions became thirteen molecules made.",
   "w_first": "8-03.w012",
   "w_last": "8-03.w019",
   "f0": 386,
   "f1": 645
  },
  {
   "sid": "8-03.s4",
   "text": "And on a road measured in years, the first hit came in 30 days, and round two made the key turn.",
   "w_first": "8-03.w020",
