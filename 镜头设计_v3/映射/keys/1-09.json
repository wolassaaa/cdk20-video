 "sentences": [
  {
   "sid": "1-09.s1",
   "text": "To see why, let's follow one drug's journey.",
   "w_first": "1-09.w001",
   "w_last": "1-09.w008",
   "f0": 9,
   "f1": 185
  },
  {
   "sid": "1-09.s2",
   "text": "Every medicine walks the same road.",
   "w_first": "1-09.w009",
   "w_last": "1-09.w014",
   "f0": 230,
   "f1": 379
  },
  {
   "sid": "1-09.s3",
   "text": "Find a target.",
   "w_first": "1-09.w015",
   "w_last": "1-09.w017",
   "f0": 416,
   "f1": 466
  },
  {
   "sid": "1-09.s4",
   "text": "Find a hit, a first molecule that works on it.",
   "w_first": "1-09.w018",
   "w_last": "1-09.w027",
   "f0": 495,
   "f1": 718
  },
  {
   "sid": "1-09.s5",
   "text": "Improve it.",
   "w_first": "1-09.w028",
   "w_last": "1-09.w029",
   "f0": 753,
   "f1": 796
  },
  {
   "sid": "1-09.s6",
   "text": "Test it in cells, then animals.",
   "w_first": "1-09.w030",
   "w_last": "1-09.w035",
   "f0": 825,
   "f1": 982
  },
  {
   "sid": "1-09.s7",
   "text": "Then human trials: phase one, two, three.",
   "w_first": "1-09.w036",
   "w_last": "1-09.w042",
   "f0": 1026,
   "f1": 1273
  },
  {
   "sid": "1-09.s8",
   "text": "Then approval.",
   "w_first": "1-09.w043",
   "w_last": "1-09.w044",
   "f0": 1295,
   "f1": 1339
  },
  {
   "sid": "1-09.s9",
   "text": "Any step can fail.",
   "w_first": "1-09.w045",
   "w_last": "1-09.w048",
   "f0": 1368,
   "f1": 1431
  }
 ],
