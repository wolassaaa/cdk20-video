 "sentences": [
  {
   "sid": "5-10.s1",
   "text": "Then, the big step: living cells.",
   "w_first": "5-10.w001",
   "w_last": "5-10.w006",
   "f0": 9,
   "f1": 168
  },
  {
   "sid": "5-10.s2",
   "text": "After three days with 048, Huh7 liver cancer cells, packed with CDK20, lost half their living-cell signal at about 210 nanomolar.",
   "w_first": "5-10.w007",
   "w_last": "5-10.w027",
   "f0": 219,
   "f1": 1118
  },
  {
   "sid": "5-10.s3",
   "text": "Comparison cells, HEK293, needed about 1,700.",
   "w_first": "5-10.w028",
   "w_last": "5-10.w033",
   "f0": 1157,
   "f1": 1607
  },
  {
   "sid": "5-10.s4",
   "text": "Roughly eight times more.",
   "w_first": "5-10.w034",
   "w_last": "5-10.w037",
   "f0": 1636,
   "f1": 1738
  }
 ],
