 "sentences": [
  {
   "sid": "5-01.s1",
   "text": "So, the moment of truth.",
   "w_first": "5-01.w001",
   "w_last": "5-01.w005",
   "f0": 9,
   "f1": 98
  },
  {
   "sid": "5-01.s2",
   "text": "Seven real molecules, made in a real lab.",
   "w_first": "5-01.w006",
   "w_last": "5-01.w013",
   "f0": 138,
   "f1": 321
  },
  {
   "sid": "5-01.s3",
   "text": "Do any actually grab CDK20?",
   "w_first": "5-01.w014",
   "w_last": "5-01.w018",
   "f0": 364,
   "f1": 531
  },
  {
   "sid": "5-01.s4",
   "text": "Grip is measured as Kd: roughly, how much molecule it takes to grab half the protein.",
   "w_first": "5-01.w019",
   "w_last": "5-01.w034",
   "f0": 576,
   "f1": 1070
  },
  {
   "sid": "5-01.s5",
   "text": "Lower means tighter.",
   "w_first": "5-01.w035",
   "w_last": "5-01.w037",
   "f0": 1094,
   "f1": 1167
  }
 ],
