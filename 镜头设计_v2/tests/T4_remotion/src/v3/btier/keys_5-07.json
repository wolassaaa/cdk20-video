 "sentences": [
  {
   "sid": "5-07.s1",
   "text": "Not at all.",
   "w_first": "5-07.w001",
   "w_last": "5-07.w003",
   "f0": 9,
   "f1": 44
  },
  {
   "sid": "5-07.s2",
   "text": "This is where the loop kicks in again, now with real lab data inside.",
