   "f0": 853,
   "f1": 923
  },
  {
   "sid": "5-07.s5",
   "text": "Six made and tested.",
   "w_first": "5-07.w037",
   "w_last": "5-07.w040",
   "f0": 939,
   "f1": 1014
  },
  {
   "sid": "5-07.s6",
   "text": "All within 30 days of that first hit.",
   "w_first": "5-07.w041",
