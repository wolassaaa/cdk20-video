 "sentences": [
  {
   "sid": "3-07.s1",
   "text": "In 2023, an AI platform called PandaOmics backed that hunch.",
   "w_first": "3-07.w001",
   "w_last": "3-07.w010",
   "f0": 9,
   "f1": 327
  },
  {
   "sid": "3-07.s2",
   "text": "It combed ten liver cancer data sets, over a thousand tumour samples and hundreds of healthy ones, plus research papers.",
   "w_first": "3-07.w011",
   "w_last": "3-07.w030",
   "f0": 369,
   "f1": 801
  },
  {
   "sid": "3-07.s3",
   "text": "People checked its top 20 by hand, and CDK20 came out on top, with no approved drug against it yet.",
   "w_first": "3-07.w031",
   "w_last": "3-07.w050",
   "f0": 834,
   "f1": 1273
  }
