 "sentences": [
  {
   "sid": "8-02.s1",
   "text": "How can computer-aided methods help scientists find and assess cancer drug candidates?",
   "w_first": "8-02.w001",
   "w_last": "8-02.w012",
   "f0": 9,
   "f1": 355
  },
  {
   "sid": "8-02.s2",
   "text": "In this case, at four points.",
   "w_first": "8-02.w013",
   "w_last": "8-02.w018",
   "f0": 388,
   "f1": 507
  },
  {
   "sid": "8-02.s3",
   "text": "Picking a target from data.",
   "w_first": "8-02.w019",
   "w_last": "8-02.w023",
   "f0": 537,
   "f1": 634
  },
  {
   "sid": "8-02.s4",
   "text": "Predicting the lock's shape.",
   "w_first": "8-02.w024",
   "w_last": "8-02.w027",
   "f0": 671,
   "f1": 790
  },
  {
   "sid": "8-02.s5",
   "text": "Designing new keys.",
   "w_first": "8-02.w028",
   "w_last": "8-02.w030",
   "f0": 831,
   "f1": 909
  },
  {
   "sid": "8-02.s6",
   "text": "And ranking which ones to make.",
   "w_first": "8-02.w031",
   "w_last": "8-02.w036",
   "f0": 930,
   "f1": 1056
  },
  {
   "sid": "8-02.s7",
   "text": "That's our first objective, met for this case.",
   "w_first": "8-02.w037",
   "w_last": "8-02.w044",
   "f0": 1082,
   "f1": 1320
  }
 ],
