 "sentences": [
  {
   "sid": "4-10.s1",
   "text": "It came back with 8,918 brand-new designs.",
   "w_first": "4-10.w001",
   "w_last": "4-10.w007",
   "f0": 9,
   "f1": 263
  },
  {
   "sid": "4-10.s2",
   "text": "Way too many to make.",
   "w_first": "4-10.w008",
   "w_last": "4-10.w012",
   "f0": 298,
   "f1": 369
  },
  {
   "sid": "4-10.s3",
   "text": "So each key gets tried in a virtual lock.",
   "w_first": "4-10.w013",
   "w_last": "4-10.w021",
   "f0": 394,
   "f1": 542
  },
  {
   "sid": "4-10.s4",
   "text": "That's docking: the computer predicts how a molecule might sit in the pocket, and scores the fit.",
   "w_first": "4-10.w022",
   "w_last": "4-10.w038",
   "f0": 583,
   "f1": 940
  },
  {
   "sid": "4-10.s5",
   "text": "Similar designs get grouped, 54 make the shortlist, and chemists pick just seven to make.",
   "w_first": "4-10.w039",
   "w_last": "4-10.w053",
   "f0": 996,
   "f1": 1392
  }
 ],
