 "sentences": [
  {
   "sid": "8-04.s1",
   "text": "This works in cells, not yet in people.",
   "w_first": "8-04.w001",
   "w_last": "8-04.w008",
   "f0": 32,
   "f1": 223
  },
  {
   "sid": "8-04.s2",
   "text": "The computer narrows the search.",
   "w_first": "8-04.w009",
   "w_last": "8-04.w013",
   "f0": 277,
   "f1": 389
  },
  {
   "sid": "8-04.s3",
   "text": "Experiments still decide.",
   "w_first": "8-04.w014",
   "w_last": "8-04.w016",
   "f0": 468,
   "f1": 561
  },
  {
   "sid": "8-05.s1",
   "text": "So next time you see a headline like 'AI discovers a cancer drug'...",
   "w_first": "8-05.w001",
   "w_last": "8-05.w013",
   "f0": 596,
   "f1": 849
  },
  {
   "sid": "8-06.s1",
   "text": "...ask where it really is on the road: computer, protein, cells, animals, or patients?",
   "w_first": "8-06.w001",
   "w_last": "8-06.w014",
   "f0": 884,
   "f1": 1472
  },
  {
   "sid": "8-07.s1",
   "text": "AI didn't replace the scientists.",
   "w_first": "8-07.w001",
   "w_last": "8-07.w005",
   "f0": 1501,
   "f1": 1608
  },
  {
   "sid": "8-07.s2",
   "text": "It gave them trial and error at light speed.",
   "w_first": "8-07.w006",
   "w_last": "8-07.w014",
   "f0": 1648,
   "f1": 1804
  },
  {
   "sid": "8-07.s3",
   "text": "Thanks for watching.",
   "w_first": "8-07.w015",
   "w_last": "8-07.w017",
   "f0": 1857,
   "f1": 1911
  }
 ],
