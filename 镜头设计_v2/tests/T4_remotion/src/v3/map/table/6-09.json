 "sentences": [
  {
   "sid": "6-09.s1",
   "text": "Now imagine this keeps working further down the road.",
   "w_first": "6-09.w006",
   "w_last": "6-09.w009",
   "f0": 9,
   "f1": 35
  },
  {
   "sid": "6-09.s2",
   "text": "Fewer failed molecules, lower costs, fewer animal tests, less chemical waste.",
