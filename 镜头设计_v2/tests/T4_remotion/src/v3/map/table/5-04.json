 "sentences": [
  {
   "sid": "5-04.s1",
   "text": "But then came a second test.",
   "w_first": "5-04.w001",
   "w_last": "5-04.w006",
   "f0": 9,
   "f1": 126
  },
  {
   "sid": "5-04.s2",
   "text": "Because grabbing a lock isn't the same as jamming it.",
   "w_first": "5-04.w007",
   "w_last": "5-04.w016",
   "f0": 159,
   "f1": 418
  },
  {
   "sid": "5-04.s3",
   "text": "Does 001 actually stop CDK20 from working?",
   "w_first": "5-04.w017",
   "w_last": "5-04.w023",
   "f0": 467,
   "f1": 703
  },
  {
   "sid": "5-04.s4",
   "text": "That's measured as IC50: how much you need to cut the enzyme's activity in half.",
   "w_first": "5-04.w024",
   "w_last": "5-04.w038",
   "f0": 753,
   "f1": 1173
  },
  {
   "sid": "5-04.s5",
   "text": "For 001?",
   "w_first": "5-04.w039",
   "w_last": "5-04.w040",
   "f0": 1206,
   "f1": 1285
  },
  {
   "sid": "5-04.s6",
   "text": "Above 6,000 nanomolar.",
   "w_first": "5-04.w041",
   "w_last": "5-04.w043",
   "f0": 1292,
   "f1": 1411
  },
  {
   "sid": "5-04.s7",
   "text": "Weak.",
