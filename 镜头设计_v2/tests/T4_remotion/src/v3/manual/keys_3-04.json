 "sentences": [
  {
   "sid": "3-04.s1",
   "text": "Our lock is CDK20.",
   "w_first": "3-04.w001",
   "w_last": "3-04.w004",
   "f0": 9,
   "f1": 110
  },
  {
   "sid": "3-04.s2",
   "text": "It's an enzyme, a protein with a chemical job.",
   "w_first": "3-04.w005",
   "w_last": "3-04.w013",
   "f0": 145,
   "f1": 337
  },
  {
   "sid": "3-04.s3",
   "text": "Its keyhole is a pocket where it normally grabs a small molecule called ATP.",
   "w_first": "3-04.w014",
   "w_last": "3-04.w027",
   "f0": 368,
   "f1": 678
  },
  {
   "sid": "3-04.s4",
   "text": "Plug that pocket with the right key, and the enzyme can't do its job.",
   "w_first": "3-04.w028",
   "w_last": "3-04.w041",
   "f0": 731,
   "f1": 1015
  }
 ],
