 "sentences": [
  {
   "sid": "3-08.s1",
   "text": "But here's the problem.",
   "w_first": "3-08.w001",
   "w_last": "3-08.w004",
   "f0": 9,
   "f1": 42
  },
  {
   "sid": "3-08.s2",
   "text": "To design a key, you need to see the lock.",
   "w_first": "3-08.w005",
   "w_last": "3-08.w014",
   "f0": 42,
   "f1": 131
  },
  {
   "sid": "3-08.s3",
   "text": "And no one had measured CDK20's shape.",
   "w_first": "3-08.w015",
   "w_last": "3-08.w021",
   "f0": 134,
   "f1": 205
  },
  {
   "sid": "3-08.s4",
   "text": "That takes a lot of hard lab work, and only a small fraction of proteins have ever been measured.",
   "w_first": "3-08.w022",
   "w_last": "3-08.w040",
   "f0": 246,
   "f1": 653
  },
  {
   "sid": "3-08.s5",
   "text": "Without a 3D shape, even computer predictions of binding get expensive, slow and difficult.",
   "w_first": "3-08.w041",
   "w_last": "3-08.w054",
   "f0": 694,
   "f1": 1143
  }
 ],
