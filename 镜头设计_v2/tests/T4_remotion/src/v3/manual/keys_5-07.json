   "f0": 904,
   "f1": 974
  },
  {
   "sid": "5-07.s5",
   "text": "Six made and tested.",
   "w_first": "5-07.w037",
   "w_last": "5-07.w040",
   "f0": 990,
   "f1": 1065
  },
  {
